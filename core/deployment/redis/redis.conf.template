# ERGO MS — локальный Redis (virtual_env/packages/redis)
# Сгенерировано install_redis.py; не редактируйте пути вручную без переустановки.

# Дополнительный адрес — REDIS_BIND_EXTRA, только вместе с паролем Redis.
bind {{REDIS_BIND}}
port {{REDIS_PORT}}
protected-mode yes
{{REDIS_REQUIREPASS_LINE}}
{{REDIS_ACL_USER_LINE}}

daemonize {{REDIS_DAEMONIZE}}
pidfile {{REDIS_PIDFILE}}
logfile {{REDIS_LOGFILE}}
loglevel {{REDIS_LOGLEVEL}}
dir {{REDIS_DATA_DIR}}

save 900 1
save 300 10
save 60 10000

appendonly no
# Потолок задаёт установка: доля доступной памяти или REDIS_MAXMEMORY.
# volatile-lru вытесняет только ключи с TTL. Очереди брокера без TTL остаются.
maxmemory {{REDIS_MAXMEMORY}}
maxmemory-policy volatile-lru
