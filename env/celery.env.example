# Фрагмент Celery. Копия: copy env/celery.env.example env/celery.env
# Очередь по умолчанию следует ERGO_BROKER (auto).

# Очередь задач: auto (из ERGO_BROKER) | redis | database | local (SQLite)
CELERY_BROKER_BACKEND=auto
# Свои URL брокера и результатов (иначе — databases.yaml)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/2
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3
# Срок хранения результата задачи, секунды. Пусто — сутки.
# CELERY_RESULT_EXPIRES=86400

# Задача модуля, которую оборвал перезапуск воркера или ergoms, сама не запускается снова.
# Она ждёт ergoms celery-parked --resume. off — вернуть прежний автоперезапуск.
CELERY_RESTART_HOLD=on
# Политика для модулей без modules/<name>/task_restart.yaml: hold | drop | requeue
CELERY_RESTART_POLICY=hold

# Балансировщик слотов worker: auto (overlay при старте) | recommend (отчёт) | off (только celery_workers.yaml)
CELERY_BALANCE=auto
# Резерв RAM под ОС, если измеренных процессов недостаточно (МБ)
# CELERY_BALANCE_OS_RESERVE_RAM_MB=1024
# Ядра CPU вне Celery (API, БД, redis, nginx)
# CELERY_BALANCE_RESERVE_CPU=1
# Жёсткие границы concurrency
# CELERY_BALANCE_MIN_CONCURRENCY=1
# CELERY_BALANCE_MAX_CONCURRENCY=
# GPU-probe (nvidia-smi): auto | off
CELERY_BALANCE_GPU=auto
# Не добавлять GPU-слоты, если средняя загрузка карт не ниже этого процента
# CELERY_BALANCE_GPU_UTIL_CAP=80
# Интервал --watch, секунды
# CELERY_BALANCE_WATCH_INTERVAL=30
# Доля изменения concurrency, ниже которой --watch не трогает пул (0.2 = 20%)
# CELERY_BALANCE_HYSTERESIS=0.2
# История footprint (history.jsonl) сама подрезается до ~32 МиБ; отдельно не настраивается.

# Кластер: off — план только этой машины. on — менеджер делит потолки очередей
# между узлами, которые публикуют бюджет в Redis.
# CELERY_CLUSTER=off
# manager считает план, agent только публикует бюджет своего узла
# CELERY_CLUSTER_ROLE=manager
# Пусто — имя машины. На рабочем узле Swarm подставляет имя узла само.
# ERGO_NODE_ID=
# Секунды, после которых молчащий узел выпадает из плана
# CELERY_CLUSTER_NODE_TTL=90
# TTL ключа плана в Redis. Дольше NODE_TTL: долгий круг watch не гасит очереди агента.
# Пусто — max(600, NODE_TTL*2, WATCH_INTERVAL*6)
# CELERY_CLUSTER_PLAN_TTL=600
# Адрес, который рабочий узел должен открыть, прежде чем забрать очередь с needs_network.
# Пусто — проверку не делать.
# CELERY_CLUSTER_EGRESS_URL=
# Куда класть очередь без явного placement, когда кластер включён.
# agent — medium и heavy без видеокарты сначала на рабочие узлы, остаток на основном сервере.
# off — как раньше: такая очередь остаётся на основном сервере, пока модуль сам не разрешит.
# CELERY_CLUSTER_AUTO_PLACEMENT=agent
# Сколько секунд очередь, которой на узле не хватило локального файла или сервиса,
# остаётся только на основном сервере.
# CELERY_CLUSTER_QUARANTINE_TTL=604800
# Дополнительный адрес Redis для воркеров кластера. Без пароля в databases.yaml не применяется.
# REDIS_BIND_EXTRA=

